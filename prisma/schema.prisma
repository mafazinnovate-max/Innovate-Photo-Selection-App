generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id                 String    @id @default(cuid())
  name               String
  clientName         String
  eventType          String
  shareId            String    @unique
  accessCode         String
  createdAt          DateTime  @default(now())
  description        String?
  coverImagePublicId String?
  coverImageUrl      String?
  coverPosition      Int       @default(0)
  eventDate          DateTime?
  phoneNumber        String?
  email              String?
  galleryMode        String    @default("single")
  maxSelections      Int?
  accessCodeVersion  Int       @default(1)
  studioId           String?
  deletedAt          DateTime?

  studio          Studio?         @relation(fields: [studioId], references: [id], onDelete: Cascade)
  folders         Folder[]
  galleryAccesses GalleryAccess[]
}

model Folder {
  id              String                @id @default(cuid())
  name            String
  eventId         String
  createdAt       DateTime              @default(now())
  type            String                @default("general")
  parentId        String?
  maxSelections   Int?
  selectionStatus FolderSelectionStatus @default(SELECTING)

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  images Image[]
}

model Image {
  id             String   @id @default(cuid())
  imageUrl       String
  publicId       String?
  folderId       String
  isSelected     Boolean  @default(false)
  selectionOrder Int?
  status         Boolean  @default(false)
  comment        String?
  createdAt      DateTime @default(now())
  fileName       String?

  folder     Folder      @relation(fields: [folderId], references: [id], onDelete: Cascade)
  selections Selection[]
}

model Selection {
  id        String   @id @default(cuid())
  imageId   String
  comment   String?
  createdAt DateTime @default(now())

  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)
}

model GalleryAccess {
  id            String   @id
  eventId       String
  parentId      String?
  deviceId      String
  accessVersion Int      @default(1)
  createdAt     DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, parentId, deviceId, accessVersion])
}

model Studio {
  id            String   @id @default(cuid())
  name          String
  createdAt     DateTime @default(now())
  logoUrl       String?
  logoZoom      Float    @default(1)
  logoPositionX Float    @default(0)
  logoPositionY Float    @default(0)
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  country       String   @default("India")
  website       String?
  description   String?
  internalNotes String?
  isActive      Boolean  @default(true)

  admins       Admin[]
  events       Event[]
  Subscription Subscription[]
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  name     String?
  email    String?
  phone    String?
  studioId String

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
}

model SuperAdmin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Subscription {
  id             String    @id
  plan           String    @default("Basic")
  status         String    @default("Active")
  startDate      DateTime  @default(now())
  endDate        DateTime?
  storageLimitGb Int       @default(100)
  maxEvents      Int       @default(50)
  maxCustomers   Int       @default(500)
  maxImages      Int       @default(100000)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  studioId       String

  Studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

enum FolderSelectionStatus {
  SELECTING
  COMPLETED
}
